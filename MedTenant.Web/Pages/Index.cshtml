@page
@model IndexModel
@{
    ViewData["Title"] = "Doctor List";
}

<h1>List of our Doctors</h1>

<a asp-page="/AddDoctor" class="btn btn-primary" style="margin-bottom: 15px;">Add New Doctor</a>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Specialty</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
</table>

    @foreach (var doc in Model.DoctorList)
    {
        <tr>
            <td>@doc.Name</td>
            <td>@doc.Specialty</td>
            <td>@(doc.IsActive ? "Active" : "Not Active")</td>
            
            <td>
                <a href="/EditDoctor?id=@doc.Id" class="btn btn-warning btn-sm">Edit</a>
                
                <form method="post" asp-page-handler="Deactivate" asp-route-id="@doc.Id" style="display:inline;">
                    <button type="submit" class="btn btn-danger btn-sm">Deactivate</button>
                </form>
            </td>
        </tr>
    }