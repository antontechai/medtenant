@page
@model IndexModel
@{
    ViewData["Title"] = "Doctor List";
}

<h1>List of our Doctors</h1>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Surname</th>
        <th>Speciality (ID)</th>
        <th>Status</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var doc in Model.DoctorList)
    {
        <tr>
            <td>@doc.FirstName</td>
            <td>@doc.LastName</td>
            <td>@doc.SpecialityId</td>
            <td>@(doc.IsActive ? "Active" : "Not Active")</td>
        </tr>
    }
    </tbody> 
</table>

<a href="/AddDoctor" class="btn btn-primary">Add new doctor</a>