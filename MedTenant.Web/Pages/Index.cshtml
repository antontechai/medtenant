@page
@model IndexModel
@{
    ViewData["Title"] = "Doctor List";
}

<h1>List of our Doctors</h1>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Surname</th>
        <th>Speciality (ID)</th>
        <th>Status</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var doc in Model.DoctorList)
    {
        <tr>
            <td>@doc.FirstName</td>
            <td>@doc.LastName</td>
            <td>@doc.SpecialityId</td>
            <td>@(doc.IsActive ? "Active" : "Not Active")</td>
        </tr>
        
        <td>
            <form method="post" asp-page-handler="Deactivate" asp-route-id="@doc.Id">
                <button class="btn btn-danger btn-sm">Deactivate</button>
            </form>
        </td>
    }
    </tbody> 
</table>

<a href="/AddDoctor" class="btn btn-primary">Add new doctor</a>