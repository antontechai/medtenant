@page
@model IndexModel
@{
    ViewData["Title"] = "MedTenant";
}

<div class="text-center my-5">
    <h1 class="display-4">Welcome to MedTenant</h1>
    <p class="lead">Multi-tenant clinic scheduling system.</p>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <p>Hello, @User.Identity.Name!</p>
    }
    else
    {
        <a class="btn btn-primary" asp-page="/Login">Login</a>
        <a class="btn btn-secondary" asp-page="/Register">Register</a>
    }
</div>