@page
@model MedTenant.Web.Pages.PatientViewModel
@{
    ViewData["Title"] = "Doctor List";
}

<h1>List of our Doctors</h1>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Specialty</th>
        <th>Book</th>
    </tr>
    </thead>
    
    <tbody>

    @foreach (var doc in Model.DoctorList) 
    {
        <tr>
            <td>@doc.Name</td>
            <td>@doc.Specialty</td>
            <td>
                <a asp-page="/BookAppointment" 
                   asp-route-doctorId="@doc.Id" 
                   asp-route-date="2026-05-29">
                    Book
                </a>
            </td>
        </tr> 
    }
    </tbody>
    </table>